{
  "name": "pforte",
  "private": true,
  "description": "A small, self-hosted OpenID Connect identity service for organisations whose users are managed by a back office.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @progwise/pforte-server dev",
    "dev:up": "docker compose -f compose.dev.yaml up -d --wait",
    "dev:down": "docker compose -f compose.dev.yaml down",
    "dev:keys": "node scripts/dev-keys.mjs",
    "db:generate": "pnpm --filter @progwise/pforte-db db:generate",
    "db:migrate": "pnpm --filter @progwise/pforte-db db:migrate",
    "db:seed": "pnpm --filter @progwise/pforte-db db:seed",
    "build": "pnpm -r build",
    "lint": "oxlint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
