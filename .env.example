# Copy to .env for local development. .env is gitignored.
# These are dev-only credentials matching compose.dev.yaml; never use them in production.
# Every variable is described in docs/configuration.md.

DATABASE_URL=postgres://pforte:pforte@localhost:5433/pforte
# Host port of the Postgres container from compose.dev.yaml (default 5433, so it does not clash
# with a Postgres on the usual 5432). To change it, uncomment this and use the same port in
# DATABASE_URL.
# PFORTE_DB_PORT=5433
# Port of the pforte server itself.
PORT=3300

# Public URL of the service. Must be https except for localhost.
ISSUER=http://localhost:3300

# Secrets. `pnpm dev:keys` fills these with freshly generated development keys.
# In production, set them from a secret store; each one can also be read from a
# file with NAME_FILE (e.g. COOKIE_KEYS_FILE=/run/secrets/cookie_keys).
# COOKIE_KEYS: comma-separated, at least 32 characters each; the first signs, all verify.
# JWKS: JSON Web Key Set with private signing keys; the first signs, all are published.
COOKIE_KEYS=
JWKS=

# pforte calls applications for back-channel logout. By default it refuses loopback and private
# network addresses (protection against server-side request forgery). Set to true when your
# applications run on your own network, e.g. http://erp.internal:8080/logout.
# OUTBOUND_ALLOW_PRIVATE_ADDRESSES=true

# E-mail, for sign-in codes and activation links. SMTP_URL can also be read from SMTP_URL_FILE.
# Without it, development writes the codes and links to the log and production refuses to send.
# The values below send to Mailpit from compose.dev.yaml; read the mails at http://localhost:8026.
SMTP_URL=smtp://localhost:1026
MAIL_FROM="pforte <no-reply@localhost>"
# Named in the messages.
# ORGANISATION_NAME=Example Inc.

# SMS for the second factor and password reset. Optional; see docs/sms.md for Twilio, seven.io and others.
# Without it all codes go by e-mail. Users get SMS only for a phone number they have confirmed.
# SMS_PROVIDER=http
# SMS_URL=https://api.twilio.com/2010-04-01/Accounts/ACxxxx/Messages.json
# SMS_CONTENT_TYPE=form
# SMS_BODY=To={{to}}&From={{from}}&Body={{text}}
# SMS_FROM=+4915100000000
# SMS_HEADERS={"Authorization":"Basic …"}

# Language of pages and messages when nothing else decides (de, en, fr, hu, or a language you add), a folder
# with your name, logo, colours, fonts and texts (brand.json, locales/<language>.json), and whether
# "Remember this device" is ticked by default.
# See docs/branding-and-languages.md.
# DEFAULT_LANGUAGE=en
# BRANDING_DIR=./branding
# REMEMBER_DEVICE_DEFAULT=false

# How many proxies stand between the internet and pforte (a reverse proxy, a load balancer, a Cloudflare
# tunnel). Rate limits count by client address, and behind a proxy that address is only known from
# X-Forwarded-For. 0 (default): pforte is reached directly and the header is ignored. Set it too low and
# everybody counts as one address; too high and an attacker can pick the address that counts.
# See docs/rate-limiting.md.
# TRUST_PROXY=1

# Sign-in events (login.*) in the audit log are deleted after this many days; 0 keeps them for ever.
# Events about changes made by administrators are always kept. See docs/audit-log.md.
# AUDIT_LOGIN_RETENTION_DAYS=180

# The first administrator: if pforte has no administrator, this address becomes one and is mailed the link to choose a
# password. Nothing happens once an administrator exists, so it can stay set. See docs/administration.md.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com

# The time zone in which the administration shows times (an IANA name such as Europe/Berlin). Default UTC.
# TIME_ZONE=Europe/Berlin
