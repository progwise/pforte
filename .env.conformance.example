# Settings for running pforte against the OpenID conformance suite. See docs/conformance.md.
# `pnpm conformance:setup` copies this to .env.conformance (gitignored) and generates the keys.
# This instance is reachable from the internet through a tunnel while tests run: it uses its own
# database and its own keys, never your development data.

DATABASE_URL=postgres://pforte:pforte@localhost:5433/pforte_conformance
PORT=3301
# The tunnel's public address. Must be exactly what you enter as the issuer in the suite.
ISSUER=https://conformance.pforte.dev
COOKIE_KEYS=
JWKS=

# The alias chosen in the suite's test plan; it is part of the redirect URI.
CONFORMANCE_ALIAS=progwise-pforte
