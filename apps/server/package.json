    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "10.0.13",
    "oidc-provider": "9.12.2",
    "openapi-types": "12.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
