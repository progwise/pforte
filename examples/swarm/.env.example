# Settings of one installation of pforte on a Docker Swarm (stack.yml). Copy to .env and fill in; ./setup.sh
# does the copying. The secrets are not here: they are files in ./secrets.
#
# deploy.sh loads this file with the shell (`source`): a value with spaces or < > needs quotes, as below.

# The name of the stack. Services, secrets and the address of the database carry it, so choose it before
# ./setup.sh and keep it.
STACK_NAME=pforte

# The public name of pforte. Its DNS record points at the node that runs the edge proxy.
PFORTE_HOST=id.example.com

# The image to run: a released version, or `build` to build the checkout this folder is in (see README.md).
PFORTE_IMAGE=ghcr.io/progwise/pforte:0.3.2

# How the Docker CLI reaches a manager of the swarm, as an SSH host (ssh://<this>). Empty: the Docker this
# shell talks to already.
SWARM_MANAGER=

# Where the services run and the data lives: DATA_NODE is the node, as an SSH host whose user may use Docker
# there, and DATA_DIR the folder on it. deploy.sh makes the folder there, builds there, and pins the services to
# that node, all through the Docker of that node. Empty DATA_NODE: the manager above, and without one the Docker
# of this shell. On a swarm of one node the defaults do.
DATA_DIR=/srv/pforte
DATA_NODE=

# The network of the edge proxy (caddy-docker-proxy).
PROXY_NETWORK=caddy
# Proxies between the internet and pforte: 1 for the edge proxy, 2 with a CDN in front of it.
TRUST_PROXY=1

# Mail: the sender of pforte's mails. The mail server's address is the secret ./secrets/smtp_url.
MAIL_FROM="Example Inc. <no-reply@example.com>"

# Named on the pages and in the mails.
ORGANISATION_NAME="Example Inc."
DEFAULT_LANGUAGE=en
TIME_ZONE=Europe/Berlin

# Gets the activation link of the first administrator when the database is empty. Remove it afterwards.
BOOTSTRAP_ADMIN_EMAIL=

# Optional: codes by SMS (docs/sms.md has the values for your provider). With SMS_PROVIDER set, deploy.sh adds
# stack.sms.yml. The headers, which carry the credentials, are not here: they are the file ./secrets/sms_headers.
# Keep the single quotes around the body and the pattern.
#SMS_PROVIDER=http
#SMS_URL=https://sms.example.com/send
#SMS_CONTENT_TYPE=form
#SMS_BODY='to={{to}}&from={{from}}&text={{text}}'
#SMS_FROM=Example
#SMS_SUCCESS_PATTERN=

# Optional: your own name, logo, colours and texts (docs/branding-and-languages.md). A folder on the machine you
# deploy from, seen from this folder or as an absolute path; ../branding is a sample to start from. With it set,
# deploy.sh adds stack.branding.yml and copies the folder to the node.
#BRANDING_DIR=../branding

# Optional: the example application next to pforte, to have something to sign in to (stack.app.yml). Empty: no
# application. APP_IMAGE=build builds it from the checkout, as above.
APP_HOST=
APP_IMAGE=build
APP_CLIENT_ID=example-app
