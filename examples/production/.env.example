# Copy to .env (./setup.sh does it) and fill in. Every variable is described in ../../docs/configuration.md.

# The host name people use to reach pforte. Its DNS record must point to this machine, and ports 80 and 443 must be open:
# Caddy needs them to get the certificate.
PFORTE_HOST=id.example.com

# The sender of codes and links. The mail server itself (SMTP_URL) is a secret: setup.sh asks for it.
MAIL_FROM="Example Inc. <no-reply@example.com>"

ORGANISATION_NAME=Example Inc.
DEFAULT_LANGUAGE=en
TIME_ZONE=Europe/Berlin

# The first administrator: this address becomes one on the first start and is mailed a link to choose a password.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Pin a version instead of the moving "latest": see https://github.com/progwise/pforte/pkgs/container/pforte
# PFORTE_IMAGE=ghcr.io/progwise/pforte:0.1.0
